{
  "name": "dsh-skill-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configure GitHub repositories, scan them for skills (SKILL.md), and install or update them into DeepSeek Harness with one click.",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "tar": "^7.4.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
